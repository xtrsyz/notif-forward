<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_inactive"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <Switch
        android:id="@+id/enableSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/switch_label"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnListenerSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_listener_settings"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBatteryOpt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/battery_opt_request" />

</LinearLayout>
